# ============================================
# NeuroAegis Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets to version control.

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_MOCK_DATA_ENABLED=false
VITE_SIMULATE_LATENCY=false
VITE_MOCK_SEED=42

# --- Backend ---
MODEL_ASSETS_DIR=models/bonn
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# 192 MiB: local CHB-MIT maximum (177,285,376 bytes) plus margin.
MAX_EEG_UPLOAD_BYTES=201326592
LOG_LEVEL=info
ENVIRONMENT=development

# --- Auth (REQUIRED — generate with: openssl rand -hex 32) ---
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# For local development (SQLite default):
#   DATABASE_URL=sqlite:///./neuroaegis.db
# For Docker / production (PostgreSQL):
DATABASE_URL=postgresql://neuroaegis:CHANGE_ME@db:5432/neuroaegis_db

# --- Docker Compose PostgreSQL ---
POSTGRES_USER=neuroaegis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=neuroaegis_db
